    $(MICRO3D_DIR)/src/classes/javax/microedition/m3g/Graphics3D.java \
    $(MICRO3D_DIR)/src/classes/javax/microedition/m3g/Group.java \
    $(MICRO3D_DIR)/src/classes/javax/microedition/m3g/Image2D.java \
